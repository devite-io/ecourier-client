{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "./dist",
    "paths": {
      "#types/*": ["./types/*"],
      "#clients/*": ["./src/clients/*"],
      "#payloads/*": ["./src/payloads/*"],
      "#auth/*": ["./src/auth/*"],
      "#http/*": ["./src/http/*"],
      "#utils/*": ["./src/utils/*"]
    }
  },
  "include": ["./src/**/*.ts", "./types/**/*.ts"]
}
