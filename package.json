{
  "name": "@devite/ecourier-client",
  "version": "1.0.3",
  "description": "Third party API client for eCourier.",
  "repository": "devite-io/ecourier-client",
  "license": "MIT",
  "author": {
    "name": "Justus Geramb <justus@devite.io>",
    "url": "https://www.devite.io"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./api": {
      "import": "./dist/types/api/index.d.ts",
      "require": "./dist/types/api/index.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "export NODE_ENV=production && unbuild && bun run build:types",
    "build:types": "tsc --declaration --emitDeclarationOnly",
    "lint": "eslint src/**/*.ts* --fix && tsc --noEmit",
    "test": "vitest run --pass-with-no-tests --typecheck",
    "test:watch": "vitest watch --typecheck",
    "release": "bun run lint && bun run test && bun run build && git push && bun run changelogen --release && npm publish --access=public && git push --follow-tags"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "changelogen": "^0.6.2",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "unbuild": "^3.6.1",
    "vitest": "^4.1.5"
  },
  "dependencies": {
    "ofetch": "^1.5.1"
  },
  "imports": {
    "#types/*": "./dist/types/*.d.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
